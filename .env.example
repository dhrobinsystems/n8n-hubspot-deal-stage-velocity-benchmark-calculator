# =============================================================================
# hubspot-deal-stage-velocity-benchmark-calculator: environment template
# -----------------------------------------------------------------------------
# Copy to .env (never commit it), adjust values, and load it into the n8n
# process. n8n must allow Code nodes and expressions to read environment
# variables:  N8N_BLOCK_ENV_ACCESS_IN_NODE=false
#
# Credentials are NOT set here. Create them in n8n (Credentials menu):
#   HubSpot App Token ...... private app token   {{HUBSPOT_PRIVATE_APP_TOKEN}}
#   Slack API .............. bot token           {{SLACK_BOT_TOKEN}}
#   Google Sheets OAuth2 ... OAuth client        {{GOOGLE_OAUTH_CLIENT_ID}} / {{GOOGLE_OAUTH_CLIENT_SECRET}}
#
# DISCLAIMER: provided "AS IS" without warranty. See DISCLAIMER.md.
# =============================================================================

# --- Safety ------------------------------------------------------------------
# true  = compute the report and log it in "Dry-Run Telemetry" only
# false = post to Slack and/or append to Google Sheets
# (The workflow never writes to HubSpot in either mode.)
SANDBOX_MODE=true

# Optional fixed "now" for reproducible reports / backtests (ISO date). Blank = current time.
AS_OF_DATE=

# --- HubSpot -----------------------------------------------------------------
# Numeric portal (hub) ID, used only to build deal links in the report.
HUBSPOT_PORTAL_ID=your-portal-id
HUBSPOT_APP_BASE_URL=https://app.hubspot.com
# Comma-separated deal pipeline IDs to analyse (blank = every active pipeline).
PIPELINE_IDS=
# Deals whose DATE_FILTER_PROPERTY falls inside the last LOOKBACK_DAYS are analysed.
LOOKBACK_DAYS=180
# createdate (cohort view, default) | hs_lastmodifieddate (recent activity) | closedate
DATE_FILTER_PROPERTY=createdate
SEARCH_PAGE_SIZE=100
# Stage history property prefixes, tried in order; the stage ID is appended.
# HubSpot exposes hs_v2_date_entered_<stageId> and the older hs_date_entered_<stageId>.
STAGE_ENTERED_PREFIXES=hs_v2_date_entered_,hs_date_entered_
STAGE_EXITED_PREFIXES=hs_v2_date_exited_,hs_date_exited_

# --- Stall detection ---------------------------------------------------------
# benchmark = threshold is STALL_BENCHMARK_MULTIPLIER x the stage's STALL_BENCHMARK_STAT
# fixed     = threshold is STALL_THRESHOLD_DAYS for every stage
STALL_THRESHOLD_MODE=benchmark
# median | p75 | p90 | mean
STALL_BENCHMARK_STAT=median
STALL_BENCHMARK_MULTIPLIER=2
# Fixed threshold, and fallback when a stage has fewer than MIN_SAMPLE_SIZE completed visits.
STALL_THRESHOLD_DAYS=21
# Benchmark thresholds never go below this many days.
STALL_MIN_DAYS=7
# Optional per-stage thresholds in days, keyed by stage ID: {"appointmentscheduled": 10, "contractsent": 14}
STAGE_THRESHOLD_OVERRIDES_JSON=

# --- Bottleneck detection ----------------------------------------------------
# Minimum completed stage visits before a stage gets benchmark-based checks.
MIN_SAMPLE_SIZE=5
# SLOW_STAGE: stage median >= this x the median of the pipeline's other stage medians.
BOTTLENECK_DWELL_MULTIPLIER=1.5
# HIGH_STALL_RATE: share of a stage's open deals (min 3) that are stalled.
BOTTLENECK_STALL_RATE=0.3
# LOW_CONVERSION: advance rate below this (advanced / (advanced + lost)).
BOTTLENECK_MIN_CONVERSION=0.25

# --- Report content ----------------------------------------------------------
# false = stalled deals are listed by ID and link only (recommended for shared channels).
INCLUDE_DEAL_NAMES=false
MAX_STALLED_IN_REPORT=15

# --- Delivery ----------------------------------------------------------------
ENABLE_SLACK=true
SLACK_CHANNEL=#revops-reports
ENABLE_GOOGLE_SHEETS=false
# The ID from the sheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_DOCUMENT_ID={{GOOGLE_SHEETS_DOCUMENT_ID}}
GOOGLE_SHEETS_SHEET_NAME=stage_benchmarks
